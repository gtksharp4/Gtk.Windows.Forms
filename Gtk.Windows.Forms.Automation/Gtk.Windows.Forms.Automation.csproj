<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <DocumentationFile>$(MSBuildProjectDirectory)\$(MSBuildProjectName).xml</DocumentationFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackAsTool>False</PackAsTool>
        <SignAssembly>true</SignAssembly>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Authors>Piero Viano</Authors>
        <Company>Piero Viano</Company>
        <Copyright>Copyright (c) Piero Viano. All right reserved.</Copyright>
        <Title>UI automation for Gtk.Windows.Forms applications</Title>
        <Description>Drive the forms of a Gtk.Windows.Forms.Base application from code: show a form, find its controls by name, click, type, select and press keys the way a user would (disabled or hidden controls refuse input), script MessageBox answers, wait for conditions, and capture any control as a Gtk.Drawing Bitmap to compare against committed baseline images. Runs in-process and works with any test framework; Gtk.Windows.Forms.Automation.Xunit adds the single-thread xUnit runner GTK needs.</Description>
        <PackageTags>gtk;winforms;ui-automation;testing;screenshot</PackageTags>
        <PackageProjectUrl>https://gtksharp4.github.io/GtkWindowsForms/</PackageProjectUrl>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <RootNamespace>Gtk.Windows.Forms.Automation</RootNamespace>
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <AssemblyOriginatorKeyFile>..\GtkForms.snk</AssemblyOriginatorKeyFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);NU5118</NoWarn>
        <PackageId>Gtk.Windows.Forms.Automation</PackageId>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Gtk.Windows.Forms.Automation.Tests, </_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.CleanCache" Version="1.0.0" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup>
        <!-- Gtk.Drawing comes in transitively; captures are returned as its System.Drawing.Bitmap. -->
        <ProjectReference Include="..\Gtk.Windows.Forms\Gtk.Windows.Forms.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <None Include="..\gtksystem-windows-forms\Source\licenses\LICENSE.txt" Pack="true" PackagePath="\" />
        <None Include="..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
